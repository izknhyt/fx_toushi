{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IdeaPipeline",
  "type": "object",
  "required": ["schema_version", "stage_order", "stages"],
  "properties": {
    "schema_version": {"type": "string"},
    "stage_order": {
      "type": "array",
      "items": {"type": "string"}
    },
    "allow_force_roles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_-]+$": {
          "type": "object",
          "required": [
            "checklist_template",
            "required_evidence",
            "minimum_metrics",
            "min_weeks_at_stage",
            "feature_flags"
          ],
          "additionalProperties": false,
          "properties": {
            "checklist_template": {"type": "string"},
            "required_evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "path", "hash_required"],
                "additionalProperties": false,
                "properties": {
                  "id": {"type": "string"},
                  "path": {"type": "string"},
                  "hash_required": {"type": "boolean"},
                  "validation_playbook_id": {"type": "string"},
                  "expires_in_days": {"type": "integer"}
                }
              }
            },
            "minimum_metrics": {
              "type": "object",
              "additionalProperties": {"type": "number"}
            },
            "min_weeks_at_stage": {"type": "integer"},
            "feature_flags": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
