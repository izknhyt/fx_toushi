{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProviderPriority",
  "type": "object",
  "required": ["schema_version", "default_order"],
  "properties": {
    "schema_version": {"type": "string"},
    "default_order": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "fallback": {
      "type": "object",
      "properties": {
        "priority_override": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "per_symbol": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    }
  },
  "additionalProperties": false
}
