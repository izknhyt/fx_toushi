{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrokerErrorMap",
  "type": "object",
  "required": ["schema_version", "error_map"],
  "properties": {
    "schema_version": {"type": "string"},
    "error_map": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["trigger_reason", "audit_event_id", "runbook_ref", "retry_policy"],
        "properties": {
          "trigger_reason": {"type": "string"},
          "audit_event_id": {"type": "string"},
          "runbook_ref": {"type": "string"},
          "retry_policy": {
            "type": "object",
            "required": ["mode", "max_attempts"],
            "properties": {
              "mode": {"type": "string"},
              "max_attempts": {"type": "integer", "minimum": 0},
              "backoff_sec": {
                "type": "array",
                "items": {"type": "number", "minimum": 0}
              },
              "handoff_role": {"type": "string"}
            },
            "additionalProperties": false
          },
          "evidence_path_template": {"type": "string"},
          "required_context": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
