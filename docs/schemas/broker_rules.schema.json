{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fx-toushi.dev/schemas/broker_rules.schema.json",
  "title": "BrokerRules",
  "description": "Broker execution guardrails consumed by ticket sizing and HITL harness tooling.",
  "type": "object",
  "required": [
    "schema_version",
    "runbook_ref",
    "symbols"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_.\\-]+$"
    },
    "runbook_ref": {
      "type": "string",
      "minLength": 1
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "symbols": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Z0-9]{3,12}$": {
          "type": "object",
          "required": [
            "description",
            "pip_size",
            "contract_size",
            "min_lot",
            "lot_step",
            "precision",
            "min_distance_pips",
            "freeze_level_pips",
            "fifo_required",
            "margin_mode",
            "allowed_time_windows",
            "runbook_links"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "pip_size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "contract_size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_lot": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lot_step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "precision": {
              "type": "integer",
              "minimum": 0
            },
            "min_distance_pips": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "freeze_level_pips": {
              "type": "number",
              "minimum": 0
            },
            "fifo_required": {
              "type": "boolean"
            },
            "margin_mode": {
              "type": "string",
              "enum": [
                "netting",
                "hedging"
              ]
            },
            "allowed_time_windows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "start",
                  "end",
                  "timezone"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9_.\\-]+$"
                  },
                  "start": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "end": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "timezone": {
                    "type": "string",
                    "minLength": 1
                  },
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "mon",
                        "tue",
                        "wed",
                        "thu",
                        "fri",
                        "sat",
                        "sun"
                      ]
                    },
                    "uniqueItems": true
                  },
                  "notes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "runbook_links": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "max_positions": {
              "type": "integer",
              "minimum": 0
            },
            "protect_pips": {
              "type": "number",
              "minimum": 0
            },
            "allowed_order_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "market",
                  "marketable_limit",
                  "limit",
                  "stop",
                  "stop_limit",
                  "oco",
                  "trailing_stop"
                ]
              },
              "uniqueItems": true
            },
            "swap_triple_day": {
              "type": "string",
              "enum": [
                "mon",
                "tue",
                "wed",
                "thu",
                "fri"
              ]
            },
            "liquidity_tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "metadata": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
