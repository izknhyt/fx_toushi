{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "guardrails_metrics_v1",
  "type": "object",
  "required": [
    "timestamp",
    "health_state",
    "board_mode",
    "kill_switch",
    "reason"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "health_state": { "type": "string", "enum": ["ok", "warn", "degraded", "soft_stop", "hard_stop"] },
    "board_mode": { "type": "string", "enum": ["normal", "guarded", "halted"] },
    "kill_switch": { "type": "string", "enum": ["none", "soft_stop", "hard_stop"] },
    "spread_status": { "type": "string", "enum": ["normal", "cooldown", "block"] },
    "reason": { "type": "string" },
    "suggested_action": { "type": ["string", "null"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "exit_code": { "type": "integer" },
    "reduce_only": { "type": "boolean" },
    "ack_user": { "type": ["string", "null"] },
    "manifest_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "data_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "risk_disclosure": { "type": ["string", "null"], "enum": ["pending", "warning", "expired", "accepted", null] },
    "profit_readiness_status": { "type": "string", "enum": ["ok", "guarded", "halted", "stale"] },
    "auto_execute": { "type": "boolean" },
    "auto_execute_forced_off": { "type": "boolean" },
    "time_sync_status": { "type": ["string", "null"] },
    "time_sync_drift_ms": { "type": ["number", "null"] },
    "time_sync_reason": { "type": ["string", "null"] },
    "time_sync_action": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
