{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EmergencyConfig",
  "type": "object",
  "required": ["schema_version", "actions"],
  "properties": {
    "schema_version": {"type": "string"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "enabled"],
        "properties": {
          "id": {"type": "string"},
          "enabled": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
