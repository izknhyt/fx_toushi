{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fx-toushi.dev/schemas/audit_ticket_action.schema.json",
  "title": "TicketActionAuditRecord",
  "description": "AuditWriter ticket.action record schema per detailed design §3.6/§3.20/§16.3.",
  "type": "object",
  "required": [
    "ts",
    "record_type",
    "ticket_id",
    "action",
    "actor",
    "board_mode",
    "auto_execute",
    "guardrails",
    "delta",
    "determinism_hash",
    "determinism_version"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version tag for the audit record layout (e.g. ticket.action.v1).",
      "pattern": "^ticket\\.action\\.v[0-9]+$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "record_type": {
      "type": "string",
      "const": "ticket.action"
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": ["approve", "reject", "edit", "expire"]
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "consent_reference_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "board_mode": {
      "type": "string",
      "enum": ["normal", "guarded", "halted"]
    },
    "auto_execute": {
      "type": "boolean",
      "description": "Hands-off flag at the moment of action; false for guarded/halted or Reduce-Only."
    },
    "guardrails": {
      "type": "object",
      "required": ["kill_switch", "spread_status", "reduce_only"],
      "properties": {
        "kill_switch": { "type": "string", "enum": ["none", "soft_stop", "hard_stop"] },
        "spread_status": { "type": "string", "enum": ["normal", "cooldown", "block"] },
        "health_state": { "type": ["string", "null"], "enum": ["ok", "degraded", "halted", null] },
        "reduce_only": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "determinism_hash": { "type": ["string", "null"] },
    "determinism_version": { "type": "integer" },
    "delta": {
      "type": "object",
      "description": "Before/after diff with consent metadata required by compliance export.",
      "required": [
        "before",
        "after",
        "diff"
      ],
      "additionalProperties": true,
      "properties": {
        "before": {
          "type": "object"
        },
        "after": {
          "type": "object"
        },
        "diff": {
          "type": "object"
        },
        "decision": {
          "type": "string",
          "enum": ["approve", "reject", "edit", "expire"]
        },
        "document_hash": {
          "type": "string"
        },
        "consent_version": {
          "type": "string"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ack_user": {
          "type": ["string", "null"]
        },
        "ack_evidence": {
          "type": ["string", "null"]
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 1024
    },
    "extras": {
      "type": "object",
      "description": "Optional auxiliary metadata such as checklist acknowledgements or CLI command.",
      "additionalProperties": true
    }
  },
  "definitions": {
    "SpreadState": {
      "type": "object",
      "required": [
        "state",
        "spread_pips",
        "percentile",
        "threshold_pips",
        "cooldown_eta",
        "last_updated",
        "lookback_window_sec"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["normal", "watch", "cooldown", "halt"]
        },
        "spread_pips": {
          "type": "number",
          "minimum": 0
        },
        "percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "threshold_pips": {
          "type": "number",
          "minimum": 0
        },
        "cooldown_eta": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "lookback_window_sec": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": ["string", "null"],
          "description": "Optional human readable reason captured by SpreadMonitor."
        }
      }
    }
  }
}
