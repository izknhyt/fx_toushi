{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventBusConfig",
  "type": "object",
  "required": [
    "schema_version",
    "queue_maxsize",
    "backpressure_policy",
    "retention_days",
    "archive_compression",
    "metrics_path"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "queue_maxsize": {"type": "integer", "minimum": 1},
    "backpressure_policy": {"type": "string"},
    "retention_days": {"type": "integer", "minimum": 1},
    "archive_compression": {"type": "string"},
    "metrics_path": {"type": "string"}
  },
  "additionalProperties": false
}
