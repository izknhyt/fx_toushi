{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fx-toushi.dev/schemas/feature_flags.schema.json",
  "title": "FeatureFlagsConfig",
  "description": "Feature Flag defaults and governance metadata shared across Backtest/Paper/Live modes.",
  "type": "object",
  "required": [
    "schema_version",
    "defaults",
    "definitions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^feature_flags\\.v[0-9]+$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "last_reviewed_at": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "backtest",
        "paper",
        "live"
      ],
      "additionalProperties": false,
      "properties": {
        "backtest": {
          "$ref": "#/$defs/defaultFlags"
        },
        "paper": {
          "$ref": "#/$defs/defaultFlags"
        },
        "live": {
          "$ref": "#/$defs/defaultFlags"
        }
      }
    },
    "definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_.-]+$": {
          "$ref": "#/$defs/flagDefinition"
        }
      }
    }
  },
  "$defs": {
    "defaultFlags": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9_.-]+$": {
          "type": "boolean"
        }
      }
    },
    "flagDefinition": {
      "type": "object",
      "required": [
        "milestone",
        "owner",
        "category",
        "runbook_ref",
        "enable_conditions",
        "rollback"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "milestone": {
          "type": "string",
          "pattern": "^M[0-9](\\.[0-9])?$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "safe",
            "guarded",
            "dangerous"
          ]
        },
        "runbook_ref": {
          "type": "string",
          "minLength": 1
        },
        "enable_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rollback": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "telemetry_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
