{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fx-toushi.dev/schemas/gate_state.schema.json",
  "title": "GateState",
  "description": "Operational gate state snapshot per detailed design §4.2 and §5.4.",
  "type": "object",
  "required": [
    "market",
    "risk",
    "human"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9_.\\-]+$"
        }
      ]
    },
    "market": {
      "type": "object",
      "required": [
        "news",
        "calendar",
        "spread"
      ],
      "additionalProperties": false,
      "properties": {
        "news": {
          "type": "object",
          "required": [
            "blocked"
          ],
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "release_ts": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "calendar": {
          "type": "object",
          "required": [
            "blocked",
            "holiday_block"
          ],
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "type": "boolean"
            },
            "holiday_block": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "spread": {
          "type": "object",
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "normal",
                "watch",
                "cooldown",
                "halt"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "cooldown_eta": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "per_symbol": {
          "type": "object",
          "description": "Symbol-specific gate blocks that override global news/calendar/spread settings.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "news": {
                "type": "object",
                "required": [
                  "blocked"
                ],
                "additionalProperties": false,
                "properties": {
                  "blocked": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "release_ts": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              },
              "calendar": {
                "type": "object",
                "required": [
                  "blocked",
                  "holiday_block"
                ],
                "additionalProperties": false,
                "properties": {
                  "blocked": {
                    "type": "boolean"
                  },
                  "holiday_block": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "spread": {
                "type": "object",
                "required": [
                  "state"
                ],
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "normal",
                      "watch",
                      "cooldown",
                      "halt"
                    ]
                  },
                  "reason": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cooldown_eta": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                }
              }
            },
            "minProperties": 1
          }
        }
      }
    },
    "auto_execute": {
      "type": "boolean",
      "description": "Hands-off flag. Only true when board_mode=normal and profit readiness KPIs are satisfied; guarded/halt must set false."
    },
    "risk": {
      "type": "object",
      "required": [
        "reduce_only"
      ],
      "additionalProperties": false,
      "properties": {
        "reduce_only": {
          "type": "boolean"
        },
        "reduce_only_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "human": {
      "type": "object",
      "required": [
        "double_entry_required",
        "required_roles",
        "acknowledged_roles",
        "manual_comment_required",
        "comment_min_length"
      ],
      "additionalProperties": false,
      "properties": {
        "double_entry_required": {
          "type": "boolean"
        },
        "required_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "acknowledged_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          }
        },
        "ack_deadline": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "manual_comment_required": {
          "type": "boolean"
        },
        "comment_min_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
