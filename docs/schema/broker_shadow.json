{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fx-toushi.dev/docs/schema/broker_shadow.json",
  "title": "Broker Shadow Contracts",
  "type": "object",
  "description": "Data structures emitted by the FillShadow pipeline (detailed design §80.1).",
  "$defs": {
    "ShadowFillRecord": {
      "type": "object",
      "required": [
        "shadow_id",
        "ticket_id",
        "order_id",
        "account_id",
        "symbol",
        "direction",
        "lots",
        "price_request",
        "price_ack",
        "price_final",
        "slippage_pips",
        "ttl_sec",
        "status",
        "fill_ts",
        "ack_latency_ms",
        "fill_latency_ms",
        "board_mode",
        "kill_switch_state",
        "policy_flags",
        "statement_ref",
        "raw_payload"
      ],
      "additionalProperties": false,
      "properties": {
        "shadow_id": {
          "type": "string",
          "description": "Primary key generated by FillShadowRecorder.",
          "pattern": "^shadow_[0-9A-Za-z]{8,}$"
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z]{6}$"
        },
        "direction": {
          "type": "string",
          "enum": ["buy", "sell"]
        },
        "lots": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "price_request": {
          "type": "number"
        },
        "price_ack": {
          "type": ["number", "null"]
        },
        "price_final": {
          "type": ["number", "null"]
        },
        "slippage_pips": {
          "type": "number"
        },
        "ttl_sec": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "filled",
            "partial",
            "rejected",
            "cancelled",
            "blocked"
          ]
        },
        "fill_ts": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "ack_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "fill_latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "board_mode": {
          "type": "string",
          "enum": ["normal", "guarded", "halted"]
        },
        "kill_switch_state": {
          "type": "string",
          "enum": ["running", "soft_stop", "stop"]
        },
        "policy_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "statement_ref": {
          "type": ["string", "null"],
          "description": "Reference into statement reconciliation pipeline."
        },
        "raw_payload": {
          "type": "object",
          "description": "Adapter-specific payload captured for auditing purposes.",
          "additionalProperties": true
        }
      }
    },
    "FillDriftAlert": {
      "type": "object",
      "required": [
        "ticket_id",
        "order_id",
        "dimension",
        "expected",
        "actual",
        "tolerance",
        "severity",
        "runbook_ref",
        "evidence_path"
      ],
      "additionalProperties": false,
      "properties": {
        "alert_id": {
          "type": "string",
          "pattern": "^drift_[0-9A-Za-z]{6,}$"
        },
        "ticket_id": {
          "type": "string",
          "minLength": 1
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "enum": [
            "price",
            "lots",
            "swap",
            "commission",
            "status",
            "ttl"
          ]
        },
        "expected": {
          "type": ["number", "string"]
        },
        "actual": {
          "type": ["number", "string"]
        },
        "tolerance": {
          "type": ["number", "string"]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "minor", "major", "critical"]
        },
        "runbook_ref": {
          "type": "string",
          "pattern": "^RUN-[A-Z0-9\-]+(#.+)?$"
        },
        "evidence_path": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "FillReplayReport": {
      "type": "object",
      "required": [
        "replay_id",
        "adapter",
        "orders_replayed",
        "fills_replayed",
        "avg_ack_latency_ms",
        "avg_fill_latency_ms",
        "mismatch_count",
        "board_mode_histogram",
        "kill_switch_histogram",
        "drift_summary"
      ],
      "additionalProperties": false,
      "properties": {
        "replay_id": {
          "type": "string",
          "pattern": "^replay_[0-9A-Za-z]{8,}$"
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "orders_replayed": {
          "type": "integer",
          "minimum": 0
        },
        "fills_replayed": {
          "type": "integer",
          "minimum": 0
        },
        "avg_ack_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "avg_fill_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "mismatch_count": {
          "type": "integer",
          "minimum": 0
        },
        "board_mode_histogram": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "kill_switch_histogram": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "drift_summary": {
          "type": "object",
          "properties": {
            "price": {"type": "integer", "minimum": 0},
            "lots": {"type": "integer", "minimum": 0},
            "swap": {"type": "integer", "minimum": 0},
            "status": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
